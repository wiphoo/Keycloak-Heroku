# Example environment variables for Keycloak on Heroku
# Copy this file to .env for local development (DO NOT commit .env)

# PostgreSQL Database URL
# Format: postgres://username:password@host:port/database
# Example for Neon: postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://username:password@localhost:5432/keycloak

# Keycloak Admin Credentials
# Change these to strong, secure values!
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_to_strong_password

# Optional: Custom Hostname
# If not set, will use Heroku app domain
# KEYCLOAK_HOSTNAME=your-custom-domain.com

# Port (automatically set by Heroku, only needed for local dev)
PORT=8080
